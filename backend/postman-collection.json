{
  "info": {
    "name": "Blog Dashboard API",
    "description": "API collection for Blog Dashboard System",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check Server Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with React\",\n  \"description\": \"Learn the basics of React\",\n  \"content\": \"<h1>React</h1><p>React is a JavaScript library for building user interfaces.</p>\",\n  \"status\": \"PUBLISHED\"\n}"
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/posts"
          }
        },
        {
          "name": "Get All Posts (Draft)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/posts?status=DRAFT"
          }
        },
        {
          "name": "Get All Posts (Published)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/posts?status=PUBLISHED"
          }
        },
        {
          "name": "Get Single Post",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/posts/{{post_id}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/posts/{{post_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"Updated description\",\n  \"content\": \"<p>Updated content</p>\",\n  \"status\": \"PUBLISHED\"\n}"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/posts/{{post_id}}"
          }
        },
        {
          "name": "Increment Views",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/posts/{{post_id}}/view"
          }
        },
        {
          "name": "Increment Likes",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/posts/{{post_id}}/like"
          }
        }
      ]
    },
    {
      "name": "Statistics",
      "item": [
        {
          "name": "Get Overall Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats"
          }
        },
        {
          "name": "Get Posts Over Time",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats/posts-over-time?days=30"
          }
        },
        {
          "name": "Get Views Per Post",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats/views-per-post"
          }
        },
        {
          "name": "Get Draft vs Published",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats/draft-vs-published"
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Get Recent Activities",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/activities?limit=20"
          }
        },
        {
          "name": "Get Post Activities",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/activities/post/{{post_id}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "post_id",
      "value": ""
    }
  ]
}
