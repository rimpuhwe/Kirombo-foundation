# Supabase (Database + Auth) — see supabase/schema.sql and README.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (article image uploads via unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─── Supabase Edge Function secrets ───────────────────────────────────────
# Email (Join the Mission form + writer invite emails) is sent server-side by
# Supabase Edge Functions via Brevo. These are listed here for reference only
# — Vite never reads them (no VITE_ prefix, so they're never bundled into the
# client). Set the real values as Supabase secrets, not in this app's .env:
#   supabase secrets set BREVO_API_KEY=...
#   supabase secrets set BREVO_SENDER_EMAIL=...
#   supabase secrets set BREVO_SENDER_NAME=...
# See README.md "Managing writers & admins" for the full list (SITE_URL,
# CONTACT_RECIPIENT_EMAIL, etc.) and deployment steps.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
